# Public by design: these values are embedded in the browser bundle.
# Access control must be enforced by Supabase grants and RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: never prefix these names with NEXT_PUBLIC_.
# Required by the account-deletion route and privileged jobs.
SUPABASE_SECRET_KEY=
AI_GATEWAY_API_KEY=
RESEND_API_KEY=
MARKET_DATA_API_KEY=
CRON_SECRET=

# Set when Server Actions are introduced so deployments share one key.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
